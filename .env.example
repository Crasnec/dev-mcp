# Absolute host directory exposed read-write only to runner.
WORKSPACE_DIR=/absolute/path/to/workspace
# Shared only with the gateway. Each user runner receives its own subdirectory.
# Set an absolute Docker-host path when Docker runs in another host namespace.
# USER_RUNNER_IPC_DIR=/absolute/host/path/to/dev-mcp-user-ipc
# Set this when Docker runs on another host namespace (for example Docker-outside-of-Docker).
# CADDYFILE_PATH=/absolute/host/path/to/dev-mcp/Caddyfile
DEV_UID=1000
DEV_GID=1000

MCP_DOMAIN=mcp.example.com
ACME_EMAIL=admin@example.com
# Keep staging until the complete flow succeeds, then switch to the production URL below.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Initial admin account: username admin. Used only when users.json is first created.
# Also used to sign image URLs; keep configured after changing the admin password.
# Generate interactively with: npm run password-hash
ADMIN_PASSWORD_HASH=scrypt:REPLACE_ME

# Google-only signup. Copy files opaquely with node scripts/import-google-secrets.mjs.
# Enable with docker compose -f compose.yaml -f compose.google.yaml up -d --build
# Optional absolute paths ON THE DOCKER HOST for the copied credentials:
# GOOGLE_CLIENT_ID_SOURCE=/absolute/path/to/dev-mcp/data/google/oauth-id.txt
# GOOGLE_CLIENT_SECRET_SOURCE=/absolute/path/to/dev-mcp/data/google/oauth-secret.txt
# For a non-Docker gateway use GOOGLE_CLIENT_ID_FILE / GOOGLE_CLIENT_SECRET_FILE.
# Google Console callback: https://<MCP_DOMAIN>/auth/google/callback

MAX_CONCURRENT_COMMANDS=4
MAX_CONCURRENT_PROCESSES=8
# 0 means no runner-side default timeout. Individual command_run calls may set one.
DEFAULT_COMMAND_TIMEOUT_MS=0
MAX_OUTPUT_BYTES=65536

# Required only for git_commit; read-only Git tools work without these values.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
