# Absolute host directory exposed read-write only to runner.
WORKSPACE_DIR=/absolute/path/to/workspace
# Set this when Docker runs on another host namespace (for example Docker-outside-of-Docker).
# CADDYFILE_PATH=/absolute/host/path/to/dev-mcp/Caddyfile
DEV_IMAGE=local/dev-fedora:44
DEV_UID=1000
DEV_GID=1000

MCP_DOMAIN=mcp.example.com
ACME_EMAIL=admin@example.com
# Keep staging until the complete flow succeeds, then switch to the production URL below.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Generate interactively with: npm run password-hash
ADMIN_PASSWORD_HASH=scrypt:REPLACE_ME

MAX_CONCURRENT_COMMANDS=4
MAX_CONCURRENT_PROCESSES=8
# 0 means no runner-side default timeout. Individual command_run calls may set one.
DEFAULT_COMMAND_TIMEOUT_MS=0
MAX_OUTPUT_BYTES=65536

# Required only for git_commit; read-only Git tools work without these values.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
