{
  "name": "dev-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "node scripts/check-style.mjs --fix && prettier --write 'packages/**/*.{ts,json}' 'scripts/*.mjs' '*.{json,ts}'",
    "style": "node scripts/check-style.mjs && prettier --check 'packages/**/*.{ts,json}' 'scripts/*.mjs' '*.{json,ts}'",
    "typecheck": "tsc -b --pretty false",
    "start:gateway": "node packages/gateway/dist/index.js",
    "start:runner": "node packages/runner/dist/index.js",
    "password-hash": "node scripts/hash-password.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "light-my-request": "^6.6.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
