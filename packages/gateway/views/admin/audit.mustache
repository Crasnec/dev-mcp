<section class="panel audit-panel">
  <form class="toolbar" method="get" action="/admin/audit">{{> partials/sort-fields}}<label class="filter-field grow">기록 검색<input type="search" name="q" value="{{q}}" placeholder="사용자·도구·대상 ID"></label><label class="filter-field">이벤트<select name="event"><option value="">전체 이벤트</option>{{#events}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/events}}</select></label><button class="primary" type="submit">조회</button><a class="button quiet" href="/admin/audit">초기화</a></form>
  <div data-audit-clipped>{{#clipped}}<p class="audit-clipped">최근 1 MiB의 기록을 표시합니다. 이전 기록은 서버의 보관 로그에서 확인할 수 있습니다.</p>{{/clipped}}</div>
  <div class="table-scroll">
    <table class="audit-table">
      <caption class="sr-only">감사 기록</caption>
      <colgroup><col class="audit-time-column"><col><col class="audit-actor-column"><col class="audit-action-column"></colgroup>
      <thead><tr>{{#sortHeaders.at}}{{> partials/sortable-header}}{{/sortHeaders.at}}{{#sortHeaders.event}}{{> partials/sortable-header}}{{/sortHeaders.event}}{{#sortHeaders.actor}}{{> partials/sortable-header}}{{/sortHeaders.actor}}<th>상세</th></tr></thead>
      <tbody data-audit-rows>
        {{#rows}}
        <tr id="audit-row-{{id}}" data-audit-id="{{id}}" class="audit-row{{#expanded}} expanded{{/expanded}}">
          <td class="audit-time">{{at}}</td>
          <td class="audit-event"><strong>{{event}}</strong></td>
          <td class="audit-actor">{{actor}}</td>
          <td class="audit-action"><a class="button small audit-detail-toggle" data-audit-toggle data-detail-url="/admin/audit/{{id}}/detail" href="{{detailHref}}" aria-expanded="{{expandedText}}" aria-controls="audit-detail-{{id}}">{{detailLabel}}</a></td>
        </tr>
        <tr id="audit-detail-{{id}}" data-audit-detail-row="{{id}}" class="audit-detail-row"{{^expanded}} hidden{{/expanded}}><td colspan="4"><div data-audit-detail-content>{{#expanded}}{{> partials/audit-detail}}{{/expanded}}</div></td></tr>
        {{/rows}}
        {{^rows}}<tr><td colspan="4" class="empty-state">조건에 맞는 기록이 없습니다.</td></tr>{{/rows}}
      </tbody>
    </table>
  </div>
  <div data-audit-pagination>{{> partials/pagination}}</div>
</section>
