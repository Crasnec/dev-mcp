<section class="panel audit-panel">
  <form class="toolbar" method="get" action="{{consoleBase}}/audit">{{> partials/sort-fields}}{{#owner}}<input type="hidden" name="owner" value="{{owner}}">{{/owner}}<label class="filter-field grow">기록 검색<input type="search" name="q" value="{{q}}" placeholder="이유·사용자·도구·대상 ID"></label><label class="filter-field">이벤트<select name="event"><option value="">전체 이벤트</option>{{#events}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/events}}</select></label><button class="primary" type="submit">조회</button><a class="button quiet" href="{{consoleBase}}/audit">초기화</a></form>
  <div data-audit-clipped>{{#clipped}}<p class="audit-clipped">최근 1 MiB의 기록을 표시합니다. 이전 기록은 서버의 보관 로그에서 확인할 수 있습니다.</p>{{/clipped}}</div>
  <div class="table-scroll">
    <table class="audit-table" role="table">
      <caption class="sr-only">감사 기록</caption>
      <colgroup><col class="audit-time-column"><col><col class="audit-actor-column"><col class="audit-action-column"></colgroup>
      <thead role="rowgroup"><tr role="row">{{#sortHeaders.at}}{{> partials/sortable-header}}{{/sortHeaders.at}}{{#sortHeaders.event}}{{> partials/sortable-header}}{{/sortHeaders.event}}{{#sortHeaders.actor}}{{> partials/sortable-header}}{{/sortHeaders.actor}}<th scope="col" role="columnheader">상세</th></tr></thead>
      <tbody data-audit-rows role="rowgroup">
        {{#rows}}
        <tr id="audit-row-{{id}}" data-audit-id="{{id}}" class="audit-row{{#expanded}} expanded{{/expanded}}" role="row">
          <td class="audit-time" role="cell"><time datetime="{{atDateTime}}" data-local-time>{{at}}</time></td>
          <td class="audit-event" role="cell"><div class="audit-event-heading"><strong>{{event}}</strong>{{#tool}}<code class="audit-tool">{{tool}}</code>{{/tool}}</div>{{#reason}}<p class="audit-reason">{{reason}}</p>{{/reason}}</td>
          <td class="audit-actor" role="cell">{{actor}}</td>
          <td class="audit-action" role="cell"><a class="button small audit-detail-toggle" data-audit-toggle data-detail-url="{{consoleBase}}/audit/{{id}}/live" href="{{detailHref}}" aria-expanded="{{expandedText}}" aria-controls="audit-detail-{{id}}">{{detailLabel}}</a></td>
        </tr>
        <tr id="audit-detail-{{id}}" data-audit-detail-row="{{id}}" class="audit-detail-row" role="row"{{^expanded}} hidden{{/expanded}}><td colspan="4" role="cell" aria-colspan="4"><div data-audit-detail-content>{{#expanded}}{{> partials/audit-detail}}{{/expanded}}</div></td></tr>
        {{/rows}}
        {{^rows}}<tr role="row"><td colspan="4" role="cell" aria-colspan="4" class="empty-state">조건에 맞는 기록이 없습니다.</td></tr>{{/rows}}
      </tbody>
    </table>
  </div>
  <div data-audit-pagination>{{> partials/pagination}}</div>
</section>
