<section class="panel">
  <form class="toolbar" method="get" action="/admin/connections">{{#clientSort}}<input type="hidden" name="{{sortKey}}" value="{{key}}"><input type="hidden" name="{{directionKey}}" value="{{direction}}">{{/clientSort}}{{#sessionSort}}<input type="hidden" name="{{sortKey}}" value="{{key}}"><input type="hidden" name="{{directionKey}}" value="{{direction}}">{{/sessionSort}}<label class="filter-field grow">연결 검색<input type="search" name="q" value="{{q}}" placeholder="클라이언트 이름·ID 또는 사용자 아이디"></label><button class="primary" type="submit">조회</button><a class="button quiet" href="/admin/connections">초기화</a></form>
  <div class="panel-heading"><div><h2>브라우저 세션</h2><p>유효한 로그인만 표시합니다.</p></div></div>
  <div class="table-scroll"><table><caption class="sr-only">로그인 세션</caption><thead><tr>{{#sessionSortHeaders.username}}{{> partials/sortable-header}}{{/sessionSortHeaders.username}}{{#sessionSortHeaders.created}}{{> partials/sortable-header}}{{/sessionSortHeaders.created}}{{#sessionSortHeaders.expires}}{{> partials/sortable-header}}{{/sessionSortHeaders.expires}}<th>관리</th></tr></thead><tbody>{{#sessions}}<tr><td><a href="/admin/users/{{userId}}">{{username}}</a></td><td>{{createdLabel}}</td><td>{{expiresLabel}}</td><td><form method="post" action="/admin/connections/sessions/{{id}}/revoke">{{> partials/csrf}}<button class="small" type="submit">세션 종료</button></form></td></tr>{{/sessions}}{{^sessions}}<tr><td colspan="4" class="empty-state">표시할 로그인 세션이 없습니다.</td></tr>{{/sessions}}</tbody></table></div>
  {{#sessionPaging}}{{> partials/pagination}}{{/sessionPaging}}
</section>
<section class="panel">
  <div class="panel-heading"><div><h2>MCP 클라이언트</h2><p>클라이언트 등록 정보와 유효한 사용자 연결입니다.</p></div><nav class="sort-controls" aria-label="MCP 클라이언트 정렬">{{#clientSortHeaders.name}}{{> partials/sort-control}}{{/clientSortHeaders.name}}{{#clientSortHeaders.created}}{{> partials/sort-control}}{{/clientSortHeaders.created}}</nav></div>
  {{#rows}}<details class="client-record"><summary><span class="client-summary"><span class="client-summary-main"><strong>{{clientName}}</strong><code>{{clientId}}</code></span><span class="client-created">{{createdLabel}}</span></span></summary><div class="client-body"><h3>등록된 콜백 주소</h3><ul>{{#redirectUris}}<li><code>{{.}}</code></li>{{/redirectUris}}</ul><h3>연결된 사용자</h3><ul>{{#grants}}<li><a href="/admin/users/{{userId}}">{{username}}</a> · 액세스 토큰 {{accessCount}}개 · 갱신 토큰 {{refreshCount}}개</li>{{/grants}}{{^grants}}<li>유효한 사용자 연결이 없습니다.</li>{{/grants}}</ul><form class="danger-zone padded" method="post" action="/admin/connections/clients/{{clientId}}/delete">{{> partials/csrf}}<p class="help">이 클라이언트의 등록과 모든 사용자의 연결 인증을 제거합니다. 다시 연결하려면 클라이언트를 재등록해야 합니다.</p><label>확인을 위해 클라이언트 ID 입력<input name="confirmation" required autocomplete="off" placeholder="{{clientId}}"></label><button class="danger" type="submit">클라이언트 등록·연결 제거</button></form></div></details>{{/rows}}
  {{^rows}}<div class="empty-state">등록된 클라이언트가 없습니다.</div>{{/rows}}
  {{> partials/pagination}}
</section>
