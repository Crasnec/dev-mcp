<div class="detail-heading"><div><a class="back-link" href="/admin/processes?owner={{owner.id}}">← {{owner.username}}님의 프로세스</a><h2>프로세스 상세</h2><span class="badge {{process.status}}">{{process.statusLabel}}</span></div>{{#running}}<form method="post" action="/admin/processes/{{owner.id}}/{{process.id}}/stop">{{> partials/csrf}}<button class="danger" type="submit">프로세스 종료</button></form>{{/running}}</div>
<section class="panel padded"><dl class="properties"><div><dt>프로세스 ID</dt><dd><code>{{process.id}}</code></dd></div><div><dt>시작 시각</dt><dd>{{process.startedLabel}}</dd></div><div><dt>PID</dt><dd>{{process.pid}}</dd></div></dl><h3>실행 명령</h3><pre class="command-block">{{process.command}}</pre></section>
<section class="panel"><div class="panel-heading"><h2>실행 로그</h2><a class="button" href="/admin/processes/{{owner.id}}/{{process.id}}">새로고침 ↻</a></div><div class="padded log-panel-body"><pre class="log-output">{{output}}</pre>{{#nextLog}}<a class="button" href="{{nextLog}}">다음 로그 →</a>{{/nextLog}}</div></section>
