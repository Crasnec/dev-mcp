<section class="panel process-summary" aria-label="프로세스 정보">
  <div class="process-summary-heading">
    <div class="process-summary-context"><a class="back-link" href="{{consoleBase}}/processes{{^selfScope}}?owner={{owner.id}}{{/selfScope}}">← {{owner.username}}님의 프로세스</a><span class="badge {{process.status}}" data-process-status>{{process.statusLabel}}</span></div>
    {{#running}}<form data-process-stop method="post" action="{{consoleBase}}/processes/{{owner.id}}/{{process.id}}/stop">{{> partials/csrf}}<button class="danger" type="submit">프로세스 종료</button></form>{{/running}}
  </div>
  <h2 class="sr-only">실행 명령</h2>
  <pre class="command-block process-command">{{process.command}}</pre>
  <dl class="process-metadata"><div><dt>실행 방식</dt><dd>{{process.modeLabel}}</dd></div><div><dt>종료 코드</dt><dd data-process-exit>{{process.exitLabel}}</dd></div><div><dt>PID</dt><dd>{{process.pid}}</dd></div><div><dt>시작 시각</dt><dd><time datetime="{{process.startedDateTime}}" data-local-time>{{process.startedLabel}}</time></dd></div><div><dt>프로세스 ID</dt><dd><code>{{process.id}}</code></dd></div></dl>
</section>
<section class="panel process-log-panel">
  <div class="panel-heading"><h2>실행 로그</h2><a class="button" href="{{consoleBase}}/processes/{{owner.id}}/{{process.id}}">새로고침 ↻</a></div>
  <div class="padded log-panel-body">{{#logNotice}}<p class="context-message" data-log-notice>{{logNotice}}</p>{{/logNotice}}{{#logWarning}}<p class="context-message" data-log-warning>{{logWarning}}</p>{{/logWarning}}{{#logError}}<p class="error-banner" data-log-error role="alert">{{logError}}</p>{{/logError}}<pre class="log-output" data-live-log data-cursor="{{logCursor}}" tabindex="0" aria-label="프로세스 {{process.id}} 실행 로그">{{output}}</pre>{{#nextLog}}<a class="button" data-live-next href="{{nextLog}}">다음 로그 →</a>{{/nextLog}}</div>
</section>
