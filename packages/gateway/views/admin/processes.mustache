<section class="panel">
  <form class="toolbar" method="get" action="/admin/processes">{{> partials/owner-filter}}<label class="filter-field grow">명령 검색<input type="search" name="q" value="{{q}}" placeholder="실행 명령"></label><label class="filter-field">상태<select name="status"><option value="">전체 상태</option>{{#statuses}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statuses}}</select></label><button class="primary" type="submit">조회</button></form>
  {{> partials/runner-unavailable}}
  <div class="table-scroll"><table><caption class="sr-only">프로세스 목록</caption><thead><tr><th>명령</th><th>상태</th><th>PID</th><th>시작 시각</th><th>관리</th></tr></thead><tbody>
    {{#rows}}<tr><td><code class="command-preview">{{command}}</code></td><td><span class="badge {{status}}">{{statusLabel}}</span></td><td>{{pid}}</td><td>{{startedLabel}}</td><td><a class="button small" href="{{href}}">로그·상세 →</a></td></tr>{{/rows}}
    {{^rows}}<tr><td colspan="5" class="empty-state">표시할 프로세스가 없습니다.</td></tr>{{/rows}}
  </tbody></table></div>{{> partials/pagination}}
</section>
