<section class="panel" data-live-feed="processes" data-live-url="/admin/processes/live" data-live-owner="{{owner.id}}">
  <form class="toolbar" method="get" action="/admin/processes">{{> partials/sort-fields}}{{> partials/owner-filter}}<label class="filter-field grow">명령 검색<input type="search" name="q" value="{{q}}" placeholder="실행 명령"></label><label class="filter-field">상태<select name="status"><option value="">전체 상태</option>{{#statuses}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statuses}}</select></label><button class="primary" type="submit">조회</button><a class="button quiet" href="/admin/processes?owner={{owner.id}}">초기화</a></form>
  <div data-live-region="processes">
  <div data-live-unavailable{{#ready}} hidden{{/ready}}><div class="context-message">실행 환경이 응답하지 않습니다. 중지되었거나 아직 준비되지 않았을 수 있습니다. <a data-live-runner-link href="/admin/runners/{{owner.id}}">실행 환경 확인 →</a></div></div>
  <div class="table-scroll"><table><caption class="sr-only">프로세스 목록</caption><thead><tr>{{#sortHeaders.command}}{{> partials/sortable-header}}{{/sortHeaders.command}}{{#sortHeaders.status}}{{> partials/sortable-header}}{{/sortHeaders.status}}{{#sortHeaders.pid}}{{> partials/sortable-header}}{{/sortHeaders.pid}}{{#sortHeaders.started}}{{> partials/sortable-header}}{{/sortHeaders.started}}<th>관리</th></tr></thead><tbody data-live-rows>
    {{#rows}}{{> partials/live-process-row}}{{/rows}}
    {{^rows}}<tr data-live-empty><td colspan="5" class="empty-state">표시할 프로세스가 없습니다.</td></tr>{{/rows}}
  </tbody></table></div><div data-live-pagination>{{> partials/pagination}}</div>
  </div>
</section>
<template data-live-row-template>{{> partials/live-process-row}}</template>
