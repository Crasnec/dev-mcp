<section class="panel">
  <form class="toolbar" method="get" action="{{consoleBase}}/projects">{{> partials/sort-fields}}{{> partials/owner-filter}}<label class="filter-field grow">프로젝트 검색<input name="q" type="search" value="{{q}}" placeholder="이름 또는 경로"></label><button class="primary" type="submit">조회</button><a class="button quiet" href="{{consoleBase}}/projects{{^selfScope}}?owner={{owner.id}}{{/selfScope}}">초기화</a></form>
  {{> partials/runner-unavailable}}
  <div class="table-scroll"><table><caption class="sr-only">프로젝트 목록</caption><thead><tr>{{#sortHeaders.name}}{{> partials/sortable-header}}{{/sortHeaders.name}}{{#sortHeaders.path}}{{> partials/sortable-header}}{{/sortHeaders.path}}<th>관리</th></tr></thead><tbody>
    {{#rows}}<tr><td><a class="strong-link" href="{{href}}">{{name}}</a><small class="cell-secondary">{{id}}</small></td><td><code>{{relativePath}}</code></td><td><a class="button small" href="{{href}}">상세 관리 →</a></td></tr>{{/rows}}
    {{^rows}}<tr><td colspan="3" class="empty-state">{{#ready}}등록된 프로젝트가 없습니다.{{/ready}}{{^ready}}실행 환경 연결 후 프로젝트를 조회할 수 있습니다.{{/ready}}</td></tr>{{/rows}}
  </tbody></table></div>{{> partials/pagination}}
</section>
{{#ready}}<section class="panel padded">
  <h2>기존 디렉토리 등록</h2><p class="help">{{owner.username}}님의 작업 공간에 이미 존재하는 디렉토리를 프로젝트로 등록합니다.</p>
  <form method="post" action="{{consoleBase}}/projects">{{> partials/csrf}}<input type="hidden" name="owner" value="{{owner.id}}"><div class="form-grid"><label>프로젝트 이름<input name="name" required maxlength="200" placeholder="my-project"></label><label>상대 경로<input name="relative_path" required maxlength="4096" placeholder="projects/my-project"></label><button class="primary" type="submit">프로젝트 등록</button></div></form>
</section>{{/ready}}

{{#ready}}<section class="panel padded"><h2>Git 저장소 가져오기</h2>{{#development}}<p class="context-message">GitHub 인증: {{#githubConnected}}연결됨{{/githubConnected}}{{^githubConnected}}연결 필요{{/githubConnected}}</p>{{/development}}<p class="help">GitHub·GitLab·Bitbucket의 HTTPS 주소를 입력하면 복제 후 자동 등록합니다. 비공개 GitHub 저장소는 SSH 터미널에서 먼저 인증하세요.</p><pre><code>gh auth login --web --git-protocol https
gh auth setup-git</code></pre><p class="help">MCP와 SSH는 같은 HOME을 사용하므로 인증과 Git 설정을 함께 사용합니다.</p><form method="post" action="{{consoleBase}}/projects/clone">{{> partials/csrf}}<input type="hidden" name="owner" value="{{owner.id}}"><div class="form-grid"><label>프로젝트 이름<input name="name" required maxlength="200" placeholder="my-project"></label><label>HTTPS 저장소 주소<input name="repo_url" type="url" required maxlength="2048" placeholder="https://github.com/owner/repository.git"></label><label>브랜치·태그 (선택)<input name="ref" maxlength="200"></label><button class="primary" type="submit">가져오기·등록</button></div></form></section>{{/ready}}
