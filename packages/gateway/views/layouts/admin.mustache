<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f4f6f2">
  <meta name="robots" content="noindex,nofollow">
  <title>{{title}} · Dev MCP 관리</title>
  <link rel="stylesheet" href="/assets/admin.css">
  <link rel="stylesheet" href="/assets/message-dialogs.css">
  <script src="/assets/message-dialogs.js" defer></script>
  {{#livePage}}<script src="/assets/live-updates.js" defer></script>{{/livePage}}
  {{#liveAudit}}<script src="/assets/audit-updates.js" defer></script>{{/liveAudit}}
</head>
<body>
  <a class="skip-link" href="#main">본문 바로가기</a>
  <div class="admin-shell {{^isAdmin}}user-shell{{/isAdmin}}">
    <aside class="sidebar">
      {{> partials/brand}}
      <nav aria-label="관리 메뉴">
        {{#navigation}}<a href="{{href}}" {{#active}}class="active" aria-current="page"{{/active}}>{{label}}</a>{{/navigation}}
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-account"><strong title="{{actor.username}}">{{actor.username}}</strong><small>{{actor.roleLabel}}</small></div>
        <form class="sidebar-logout" method="post" action="/logout">{{> partials/csrf}}<button class="quiet" type="submit">로그아웃</button></form>
      </div>
    </aside>
    <div class="workspace">
      <main id="main"{{#livePage}} data-live-page{{/livePage}}{{#liveAudit}} data-live-audit{{/liveAudit}}{{#liveProcessUrl}} data-live-process="{{liveProcessUrl}}" data-live-running="{{#running}}true{{/running}}{{^running}}false{{/running}}" data-live-more="{{#moreLogs}}true{{/moreLogs}}{{^moreLogs}}false{{/moreLogs}}"{{/liveProcessUrl}}>
        <header class="page-heading"><div><h1>{{title}}</h1><p>{{description}}</p></div><a class="button refresh-link" href="{{refreshHref}}" aria-label="현재 화면 새로고침">새로고침 ↻</a></header>
        {{> partials/notice}}
        {{{body}}}
      </main>
      <footer class="workspace-footer"><span>Dev MCP 관리</span><span>시간 표기: UTC</span></footer>
    </div>
  </div>
</body>
</html>
