<div class="audit-detail-panel" data-audit-fragment role="region" aria-label="{{event}} 상세">
  {{#detail.command}}<details class="audit-command-section audit-request-command" open><summary>요청한 명령</summary><pre class="command-block audit-command">{{detail.command}}</pre></details>{{/detail.command}}
  {{#processId}}
  {{#detail}}
  <section class="audit-process-section">
    <div data-audit-process-meta>
      <div class="audit-process-heading"><div><h3>호출한 프로세스·작동 로그</h3>{{#ownerLabel}}<p>{{ownerLabel}}님의 실행 환경</p>{{/ownerLabel}}</div>{{#processListHref}}<a class="audit-text-link" href="{{processListHref}}">프로세스 관리 →</a>{{/processListHref}}</div>
      {{#message}}<p class="audit-message">{{message}}</p>{{/message}}
    </div>
    <div class="audit-process-list" data-audit-processes>
      {{#processes}}
      <article class="audit-process-card" data-audit-process="{{id}}" data-live-url="{{liveUrl}}" data-running="{{runningText}}" data-more="{{moreText}}">
        <header data-audit-process-header>
          <div class="audit-process-identity"><div class="audit-process-facts"><span class="badge {{status}}" data-process-status>{{statusLabel}}</span><span>{{modeLabel}}</span><span>종료 코드 <span data-process-exit>{{exitLabel}}</span></span><span>PID {{pid}}</span><span><time datetime="{{startedDateTime}}" data-local-time>{{startedLabel}}</time> 시작</span></div><strong class="audit-process-command">{{command}}</strong><code class="audit-process-id">{{id}}</code></div>
          <a class="audit-text-link" href="{{href}}">프로세스 상세 →</a>
        </header>
        {{#logError}}<p class="audit-log-error" data-log-error role="alert">{{logError}}</p>{{/logError}}
        {{#logNotice}}<p class="audit-message" data-log-notice>{{logNotice}}</p>{{/logNotice}}
        {{#logWarning}}<p class="audit-message" data-log-warning>{{logWarning}}</p>{{/logWarning}}
        {{^output}}{{^logError}}<p class="audit-log-empty" data-log-empty>아직 기록된 로그가 없습니다.</p>{{/logError}}{{/output}}
        <pre class="log-output" data-audit-log data-cursor="{{cursor}}" tabindex="0" aria-label="프로세스 {{id}} 실행 로그">{{output}}</pre>
        {{#truncated}}<p class="audit-log-note" data-log-truncated>이후 로그가 더 있습니다. <a href="{{href}}">프로세스 상세에서 보기 →</a></p>{{/truncated}}
      </article>
      {{/processes}}
    </div>
  </section>
  {{/detail}}
  {{/processId}}
  <details class="audit-raw" open><summary>원본 기록</summary><pre class="audit-json">{{details}}</pre></details>
</div>
