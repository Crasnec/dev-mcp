<tr data-live-row="{{id}}"><td><code data-live-field="command" class="command-preview">{{command}}</code></td><td><span data-live-field="status" class="badge {{status}}">{{statusLabel}}</span></td><td data-live-field="pid">{{pid}}</td><td><time data-live-field="started" datetime="{{startedDateTime}}" data-local-time>{{startedLabel}}</time></td><td><a data-live-field="href" class="button small" href="{{href}}">로그·상세 →</a></td></tr>
