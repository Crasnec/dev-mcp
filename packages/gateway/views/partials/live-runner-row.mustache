<tr data-live-row="{{id}}"><td><strong data-live-field="username">{{username}}</strong></td><td><span data-live-field="status" class="badge {{status}}">{{statusLabel}}</span></td><td><span data-live-field="connection" class="badge {{connectionStatus}}">{{connectionLabel}}</span></td><td data-live-field="projectCount">{{#ready}}{{projectCount}}개{{/ready}}{{^ready}}—{{/ready}}</td><td><a data-live-field="href" class="button small" href="{{href}}">운영·제한 관리 →</a></td></tr>
